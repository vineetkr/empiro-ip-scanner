<Window x:Class="Empiro.IpScanner.Wpf.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Empiro IP Scanner Settings" Width="500" Height="500" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource InkBrush}">
    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Save settings" IsDefault="True" Click="Save_Click" />
            <Button Content="Cancel" IsCancel="True" />
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Scanning" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10" />
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Text="Ping timeout (ms)" VerticalAlignment="Center" />
                    <TextBox x:Name="TimeoutBox" Grid.Column="1" Padding="5" />
                    <TextBlock Grid.Row="1" Text="Concurrent workers (1–64)" VerticalAlignment="Center" Margin="0,8,0,0" />
                    <TextBox x:Name="WorkersBox" Grid.Row="1" Grid.Column="1" Padding="5" Margin="0,8,0,0" />
                    <TextBlock Grid.Row="2" Text="Retries per host (0–3)" VerticalAlignment="Center" Margin="0,8,0,0" />
                    <TextBox x:Name="RetriesBox" Grid.Row="2" Grid.Column="1" Padding="5" Margin="0,8,0,0" />
                </Grid>
                <CheckBox x:Name="HostnamesCheck" Content="Resolve hostnames" Margin="0,3" />
                <CheckBox x:Name="MacCheck" Content="Resolve MAC addresses and known manufacturers" Margin="0,3" />
                <CheckBox x:Name="ArpCheck" Content="Use active ARP discovery for same-subnet devices" Margin="0,3" />
                <CheckBox x:Name="CameraCheck" Content="Discover video devices with ONVIF, Hikvision SADP and RTSP" Margin="0,3" ToolTip="Discovery can find devices on the same physical network with another IP subnet. Routers and isolated VLANs may block discovery; access still requires a route or a matching local IP." />
                <CheckBox x:Name="PortsCheck" Content="Enable optional TCP port checks" Margin="0,3" />
                <TextBlock Text="Ports (comma separated)" Margin="0,10,0,3" />
                <TextBox x:Name="PortsBox" Padding="5" />
                <Separator Margin="0,15" />
                <TextBlock Text="General" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />
                <CheckBox x:Name="RememberCheck" Content="Remember last IP range" Margin="0,3" />
                <CheckBox x:Name="ConfirmStopCheck" Content="Confirm before stopping a scan" Margin="0,3" />
                <TextBlock Text="Appearance" Margin="0,10,0,3" />
                <ComboBox x:Name="ThemeCombo" SelectedIndex="0" Padding="5">
                    <ComboBoxItem Content="Light"/><ComboBoxItem Content="Dark"/><ComboBoxItem Content="System"/>
                </ComboBox>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
