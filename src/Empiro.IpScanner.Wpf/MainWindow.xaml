<Window x:Class="Empiro.IpScanner.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Empiro IP Scanner" Width="1050" Height="660" MinWidth="820" MinHeight="500"
        Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource InkBrush}"
        Loaded="Window_Loaded" Closing="Window_Closing">
    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{x:Static NavigationCommands.Refresh}" />
        <KeyBinding Key="Escape" Command="{x:Static ApplicationCommands.Stop}" />
        <KeyBinding Key="C" Modifiers="Control" Command="{x:Static ApplicationCommands.Copy}" />
    </Window.InputBindings>
    <Window.CommandBindings>
        <CommandBinding Command="{x:Static NavigationCommands.Refresh}" Executed="Refresh_Executed" />
        <CommandBinding Command="{x:Static ApplicationCommands.Stop}" Executed="Stop_Executed" />
        <CommandBinding Command="{x:Static ApplicationCommands.Copy}" Executed="Copy_Executed" />
    </Window.CommandBindings>
    <DockPanel>
        <Menu DockPanel.Dock="Top" Background="{DynamicResource WindowBrush}">
            <MenuItem Header="_File">
                <MenuItem Header="Save results as…" Click="Export_Click" />
                <Separator />
                <MenuItem Header="Exit" Click="Exit_Click" />
            </MenuItem>
            <MenuItem Header="_Actions">
                <MenuItem Header="Scan" InputGestureText="F5" Click="Scan_Click" />
                <MenuItem Header="Camera AI monitor…" Click="CameraMonitor_Click" />
                <MenuItem Header="Stop scan" InputGestureText="Esc" Click="Stop_Click" />
                <MenuItem Header="Scan history…" Click="History_Click" />
                <MenuItem Header="Network information…" Click="NetworkInfo_Click" />
            </MenuItem>
            <MenuItem Header="_Settings" Click="Settings_Click" />
            <MenuItem Header="_View">
                <MenuItem Header="Results" Click="ShowResults_Click" />
                <MenuItem Header="Favorites" Click="ShowFavorites_Click" />
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="Authorized use" Click="AuthorizedUse_Click" />
                <MenuItem Header="About Empiro IP Scanner" Click="About_Click" />
            </MenuItem>
        </Menu>

        <StatusBar DockPanel.Dock="Bottom" Background="#E9EEF3" Padding="8,4">
            <TextBlock x:Name="StatusText" Text="Ready" Foreground="{DynamicResource MutedBrush}" />
            <Separator />
            <TextBlock x:Name="CountsText" Text="Online devices: 0" />
            <Separator />
            <ProgressBar x:Name="ScanProgress" Width="155" Height="12" Minimum="0" Maximum="100" />
            <TextBlock x:Name="ProgressText" Text="" Margin="7,0,0,0" Foreground="{DynamicResource MutedBrush}" />
        </StatusBar>

        <Grid Margin="18,12,18,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Margin="0,0,0,11">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="42" Height="42" Background="White" BorderBrush="#DCE3EA" BorderThickness="1" CornerRadius="3" Padding="2" Margin="0,0,10,0">
                        <Image Source="/Empiro-IP-Scanner;component/Assets/empiro-mark.png" Stretch="Uniform" />
                    </Border>
                    <Image Source="/Empiro-IP-Scanner;component/Assets/empiro-wordmark.png" Width="165" Height="40" Stretch="Uniform" Margin="0,0,11,0" />
                    <Border Width="1" Height="27" Background="#D6DEE7" Margin="0,0,11,0" />
                    <TextBlock Text="IP SCANNER" FontSize="18" FontWeight="SemiBold" Foreground="#14283D" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="Discover and organize devices on networks you own or are authorized to scan" Margin="52,3,0,0" Foreground="{DynamicResource MutedBrush}" />
            </StackPanel>

            <Border Grid.Row="1" Background="{DynamicResource PanelBrush}" BorderBrush="#DCE3EA" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,11">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="ScanButton" Content="▶  Scan" Background="{DynamicResource AccentBrush}" Foreground="White" FontWeight="SemiBold" Click="Scan_Click" />
                        <Button x:Name="PauseButton" Content="Ⅱ  Pause" IsEnabled="False" Click="Pause_Click" />
                        <Button x:Name="StopButton" Content="■  Stop" IsEnabled="False" Click="Stop_Click" />
                        <Separator Width="1" Height="28" Margin="10,0" />
                    </StackPanel>
                    <Button DockPanel.Dock="Right" Content="⌕  Detect local network" Click="DetectNetwork_Click" />
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="IP range(s)" VerticalAlignment="Center" Margin="4,0,9,0" />
                        <ComboBox x:Name="RangeCombo" Grid.Column="1" IsEditable="True" IsTextSearchEnabled="False" MinWidth="260" FontSize="13" Padding="4" KeyDown="RangeCombo_KeyDown" ToolTip="Enter one range or separate multiple ranges with semicolons, e.g. 192.168.29.0/24; 192.168.100.0/24" />
                        <Button Grid.Column="2" Content="Scan range" Click="Scan_Click" />
                    </Grid>
                </DockPanel>
            </Border>

            <Grid Grid.Row="2">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="0,0,0,7">
                    <TextBox x:Name="SearchBox" DockPanel.Dock="Right" Width="220" Padding="7,5" VerticalContentAlignment="Center" ToolTip="Filter by IP, name, MAC, manufacturer, status, or type" TextChanged="SearchBox_TextChanged" />
                    <TextBlock DockPanel.Dock="Right" Text="Filter  " VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" />
                    <TabControl x:Name="ResultsTabs" SelectionChanged="ResultsTabs_SelectionChanged" Background="Transparent" BorderThickness="0">
                        <TabItem Header="Results" />
                        <TabItem Header="Favorites" />
                    </TabControl>
                </DockPanel>
                <DataGrid x:Name="DeviceGrid" Grid.Row="1" ItemsSource="{Binding DeviceView}" SelectionChanged="DeviceGrid_SelectionChanged" MouseDoubleClick="DeviceGrid_DoubleClick" PreviewMouseRightButtonDown="DeviceGrid_PreviewMouseRightButtonDown">
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Explore" Tag="http" Click="Tool_Click" />
                            <MenuItem Header="Radmin" IsEnabled="False" ToolTip="Configure an external Radmin client to enable this action" />
                            <MenuItem Header="Tools">
                                <MenuItem Header="Ping" Tag="ping" Click="Tool_Click" />
                                <MenuItem Header="Traceroute" Tag="tracert" Click="Tool_Click" />
                                <MenuItem Header="Telnet" Tag="telnet" Click="Tool_Click" />
                                <MenuItem Header="SSH" Tag="ssh" Click="Tool_Click" />
                                <MenuItem Header="HTTP" Tag="http" Click="Tool_Click" />
                                <MenuItem Header="HTTPS" Tag="https" Click="Tool_Click" />
                                <MenuItem Header="FTP" Tag="ftp" Click="Tool_Click" />
                                <MenuItem Header="RDP" Tag="rdp" Click="Tool_Click" />
                                <Separator />
                                <MenuItem Header="Wake-On-LAN" Tag="wol" Click="Tool_Click" />
                            </MenuItem>
                            <MenuItem Header="Copy">
                                <MenuItem Header="Copy IP address" Tag="ip" Click="CopyField_Click" />
                                <MenuItem Header="Copy hostname" Tag="name" Click="CopyField_Click" />
                                <MenuItem Header="Copy MAC address" Tag="mac" Click="CopyField_Click" />
                                <MenuItem Header="Copy all information" Tag="all" Click="CopyField_Click" />
                            </MenuItem>
                            <MenuItem Header="Rescan selected" Click="RescanSelected_Click" />
                            <MenuItem Header="Save as…" Click="Export_Click" />
                            <MenuItem x:Name="FavoriteMenuItem" Header="Add to Favorites" Click="Favorite_Click" />
                            <MenuItem Header="Rename…" Click="Rename_Click" />
                            <MenuItem Header="Edit comment…" Click="Comment_Click" />
                            <MenuItem Header="Advanced" IsEnabled="False" />
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Status" Width="100" SortMemberPath="Status">
                            <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="●" Margin="0,0,6,0">
                                        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#929BA5"/><Style.Triggers><DataTrigger Binding="{Binding Status}" Value="Online"><Setter Property="Foreground" Value="#229260"/></DataTrigger><DataTrigger Binding="{Binding Status}" Value="Error"><Setter Property="Foreground" Value="#C64C46"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding Status}" />
                                </StackPanel>
                            </DataTemplate></DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="1.2*" />
                        <DataGridTextColumn Header="IP Address" Binding="{Binding IpAddress}" Width="150" />
                        <DataGridTextColumn Header="Manufacturer" Binding="{Binding Manufacturer}" Width="1.2*" />
                        <DataGridTextColumn Header="MAC Address" Binding="{Binding MacAddress}" Width="150" />
                        <DataGridTextColumn Header="Response" Binding="{Binding ResponseTime}" Width="95" />
                        <DataGridTextColumn Header="Ports" Binding="{Binding Ports}" Width="120" />
                        <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="95" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
