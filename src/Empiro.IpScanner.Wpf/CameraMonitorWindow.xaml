<Window x:Class="Empiro.IpScanner.Wpf.CameraMonitorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Empiro Camera AI Monitor" Width="1450" Height="900" MinWidth="1100" MinHeight="700"
        Background="#111820" Foreground="#E8EEF5" Closing="Window_Closing">
    <Grid Margin="14">
        <Grid.ColumnDefinitions><ColumnDefinition Width="320"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="#1B2631" CornerRadius="8" Padding="14" Margin="0,0,12,0">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="CAMERA SOURCES" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
                    <Button Content="Discover cameras (ONVIF / SADP)" Click="Scan_Click" Height="38" ToolTip="Search all local IPv4 interfaces, including replies from other IP subnets on the same physical network."/>
                    <TextBlock x:Name="ScanStatus" Text="Find ONVIF cameras on this LAN" Foreground="#9FB0C0" Margin="2,5,0,10" TextWrapping="Wrap"/>
                    <ListBox x:Name="CameraList" Height="230" DisplayMemberPath="Name" SelectionChanged="CameraList_SelectionChanged"/>
                    <Button Content="Resolve RTSP with ONVIF credentials" Click="ResolveOnvif_Click" Margin="0,6,0,0" Height="34"/>
                    <TextBlock Text="RTSP connection" FontWeight="SemiBold" Margin="0,16,0,6"/>
                    <TextBlock Text="Discovered cameras do not always advertise a usable stream URI. Enter or paste the camera's RTSP URL." Foreground="#9FB0C0" TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <Expander Header="Build URL from camera fields" Margin="0,0,0,6">
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="75"/><ColumnDefinition Width="*"/><ColumnDefinition Width="55"/><ColumnDefinition Width="70"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <TextBlock Text="IP / host" VerticalAlignment="Center"/><TextBox x:Name="HostInput" Grid.Column="1" Margin="2" Padding="4"/>
                            <TextBlock Grid.Column="2" Text="Port" VerticalAlignment="Center"/><TextBox x:Name="PortInput" Grid.Column="3" Text="554" Margin="2" Padding="4"/>
                            <TextBlock Grid.Row="1" Text="Username" VerticalAlignment="Center"/><TextBox x:Name="UsernameInput" Grid.Row="1" Grid.Column="1" Margin="2" Padding="4"/>
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="Password" VerticalAlignment="Center"/><PasswordBox x:Name="PasswordInput" Grid.Row="1" Grid.Column="3" Margin="2" Padding="4"/>
                            <TextBlock Grid.Row="2" Text="Path" VerticalAlignment="Center"/><TextBox x:Name="PathInput" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Text="/Streaming/Channels/101" Margin="2" Padding="4"/>
                            <Button Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" Content="Build RTSP URL" Click="BuildUrl_Click" Margin="2"/>
                        </Grid>
                    </Expander>
                    <TextBlock Text="RTSP URL" Foreground="#B6C5D2"/>
                    <TextBox x:Name="RtspUrl" Margin="0,4,0,8" Padding="6" ToolTip="rtsp://username:password@camera-ip:554/path"/>
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="ConnectButton" Content="Connect" Click="Connect_Click" Width="110" Height="36"/>
                        <Button x:Name="StopButton" Content="Stop" Click="Stop_Click" Width="90" Height="36" IsEnabled="False"/>
                    </StackPanel>
                    <Separator Margin="0,14,0,10"/>
                    <TextBlock Text="AI MODEL" FontSize="14" FontWeight="Bold" Margin="0,0,0,8"/>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Browse…" Click="BrowseModel_Click"/>
                        <TextBox x:Name="ModelPath" Padding="6" IsReadOnly="True" ToolTip="Ultralytics YOLOv8/YOLO11 detection ONNX"/>
                    </DockPanel>
                    <TextBlock Text="Provide your own compatible ONNX model. Optional coco.names beside model overrides labels." Foreground="#9FB0C0" TextWrapping="Wrap" Margin="0,6,0,0"/>
                </StackPanel>
                <StackPanel VerticalAlignment="Bottom">
                    <Separator Margin="0,12,0,8"/>
                    <CheckBox x:Name="DetectionToggle" Content="Enable object detection" IsChecked="True" IsEnabled="False" Checked="DetectionSetting_Changed" Unchecked="DetectionSetting_Changed"/>
                    <DockPanel Margin="0,8,0,0">
                        <TextBlock Text="Confidence" VerticalAlignment="Center"/>
                        <TextBlock x:Name="ConfidenceText" DockPanel.Dock="Right" Text="0.45" VerticalAlignment="Center"/>
                    </DockPanel>
                    <Slider x:Name="ConfidenceSlider" Minimum="0.1" Maximum="1" Value="0.45" ValueChanged="ConfidenceSlider_Changed"/>
                    <TextBlock x:Name="ModelStatus" Text="No model loaded · video-only mode available" Foreground="#9FB0C0" TextWrapping="Wrap" Margin="0,6,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <Grid Grid.Column="1">
            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Border Background="#05080B" CornerRadius="8" ClipToBounds="True">
                <Grid>
                    <Image x:Name="VideoImage" Stretch="Uniform"/>
                    <TextBlock x:Name="VideoPlaceholder" Text="Connect to an RTSP camera to start live video" Foreground="#8EA1B2" FontSize="19" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Border VerticalAlignment="Top" HorizontalAlignment="Left" Margin="12" Background="#C9101820" CornerRadius="4" Padding="8,5">
                        <TextBlock x:Name="ConnectionStatus" Text="Disconnected"/>
                    </Border>
                </Grid>
            </Border>
            <DockPanel Grid.Row="1" Margin="2,10,2,0">
                <TextBlock x:Name="PerformanceStatus" Text="Stream: — FPS   Detection: — ms" Foreground="#BAC7D3"/>
                <TextBlock DockPanel.Dock="Right" Text="Frames are dropped under load to keep the preview live" Foreground="#8293A2"/>
            </DockPanel>
        </Grid>
    </Grid>
</Window>
